---
interface Props {
  postTitle: string;
  guideTitle?: string;
}

const { postTitle, guideTitle = "המדריך המלא" } = Astro.props;
---

<div class="lead-gen-container my-8" id="lead-gen-section">
  <div class="inline-lead-box relative overflow-hidden rounded-2xl border border-accent/40 bg-gradient-to-br from-accent/10 via-background to-accent/5 p-5 md:p-6 text-center backdrop-blur-xl shadow-md transition-all hover:shadow-lg">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-start">
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xl">🎁</span>
          <h3 class="text-lg md:text-xl font-bold text-foreground">רוצים את {guideTitle}?</h3>
        </div>
        <p class="text-sm text-muted-foreground">הזינו פרטים קצרים וקבלו את המדריך המעשי ישירות אליכם ללא עלות.</p>
      </div>
      
      <form id="lead-form" class="w-full md:w-auto flex flex-col sm:flex-row items-center gap-2">
        <input type="hidden" name="postTitle" value={postTitle} />
        
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="כתובת האימייל שלך"
          class="w-full sm:w-56 rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm outline-none transition-all focus:border-accent focus:ring-2 focus:ring-accent/20"
        />

        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          placeholder="וואטסאפ (אופציונלי)"
          class="w-full sm:w-44 rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm outline-none transition-all focus:border-accent focus:ring-2 focus:ring-accent/20"
        />

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full sm:w-auto shrink-0 flex items-center justify-center rounded-xl bg-accent px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-accent/25 transition-all hover:brightness-110 active:scale-95 disabled:opacity-50"
        >
          <span>קבלו את המדריך!</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ms-1.5">
            <path d="m22 2-7 20-4-9-9-4Z"></path>
            <path d="M22 2 11 13"></path>
          </svg>
        </button>
      </form>
    </div>
    
    <p id="form-status" class="mt-2 text-center text-xs font-bold transition-all opacity-0"></p>
    <p class="mt-1.5 text-center text-[11px] text-muted-foreground/70">🔒 המידע שלכם מאובטח לחלוטין. ללא ספאם.</p>
  </div>
</div>

<script>
  // שימוש ב-Astro:page-load כדי לוודא שזה עובד גם בניווט בין דפים
  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector("#lead-form") as HTMLFormElement;
    const status = document.querySelector("#form-status") as HTMLElement;
    const submitBtn = document.querySelector("#submit-btn") as HTMLButtonElement;

    if (!form || !status || !submitBtn) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      
      // שינוי מצב כפתור
      submitBtn.disabled = true;
      submitBtn.innerHTML = "שולח...";
      
      const formData = new FormData(form);
      const data = {
        email: formData.get("email"),
        phone: formData.get("phone"),
        postTitle: formData.get("postTitle"),
      };

      const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwD-g9O9vPb2zfMjCDsHPdS4XI5WPLrjeAv0TkQeobud5120_MhdQKPsjVodBUsAYE27w/exec";

      try {
        if (SCRIPT_URL === "YOUR_SCRIPT_URL_HERE") {
          console.log("Mock submission:", data);
          await new Promise(r => setTimeout(r, 1000));
        } else {
          await fetch(SCRIPT_URL, {
            method: "POST",
            mode: "no-cors",
            cache: "no-cache",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
        }

        status.textContent = "✅ נשלח בהצלחה! המדריך נפתח עכשיו...";
        status.classList.remove("text-red-500");
        status.classList.add("text-green-500", "opacity-100");
        form.reset();
        submitBtn.innerHTML = "קיבלנו! תודה.";
        window.open("https://gamma.app/docs/-wvnq78lnyv3cj4f", "_blank");
      } catch (error) {
        console.error(error);
        status.textContent = "❌ חלה שגיאה. נסו שוב מאוחר יותר.";
        status.classList.add("text-red-500", "opacity-100");
        submitBtn.disabled = false;
        submitBtn.innerHTML = "נסו שוב";
      }
    });
  });
</script>
